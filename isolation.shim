#include <errno.h>
#include <fcntl.h>
#include <grp.h>
#include <stdbool.h>
#include <sys/types.h>
#include <unistd.h>

#include "util.h"
#include "passt.h"
#include "log.h"
#include "isolation.h"
#include "conf.h"

/**
 * isolate_initial() - No-op initial isolation hook
 */
void isolate_initial(void)
{
}

/**
 * isolate_fds() - Preserve descriptors supplied through --fd and --pass-fd
 * @c:		Execution context
 * @argc:	Argument count
 * @argv:	Command line options
 */
void isolate_fds(struct ctx *c, int argc, char **argv)
{
	int fds[PASS_FDS_MAX];
	int kept_fds = 0;
	int fds_cnt;
	int prev_fd;
	int next_fd;
	int i;

	fds_cnt = conf_fds(argc, argv, fds);
	c->pasta_pass_fd = fds_cnt > 1;

	if (fds[0] >= 0 && fds[0] < 3) {
		/* Move the tap fd to a safer location */
		int new_fd = fcntl(fds[0], F_DUPFD, STDERR_FILENO + 1);

		if (new_fd < 0)
			die_perror("Could not relocate --fd descriptor");

		close(fds[0]);
		fds[0] = new_fd;
	}
	c->fd_tap = fds[0];

	/* Keep standard streams */
	prev_fd = STDERR_FILENO;

	while (1) {
		next_fd = -1;

		/* Find the next-lowest fd to keep */
		for (i = 0; i < fds_cnt; i++) {
			if (fds[i] > prev_fd && (next_fd == -1 || fds[i] < next_fd))
				next_fd = fds[i];
		}

		if (next_fd == -1)
			break;

		prev_fd = next_fd;
		kept_fds++;
	}

	if (c->pasta_pass_fd)
		debug("Kept %i user-passed file descriptors",
		      c->fd_tap < 0 ? kept_fds : kept_fds - 1);
}

/**
 * isolate_user() - Switch to the requested UID and GID
 * @c:		Execution context
 * @uid:	User ID to run as
 * @gid:	Group ID to run as
 * @use_userns:	Unused
 * @userns:	Unused
 */
void isolate_user(const struct ctx *c, uid_t uid, gid_t gid, bool use_userns,
		  const char *userns)
{
	(void)c;
	(void)use_userns;
	(void)userns;

	if (setgroups(0, NULL)) {
		/* This can fail when CAP_SETGID is unavailable. */
		if (errno != EPERM)
			die_perror("Can't drop supplementary groups");
	}

	if (setgid(gid))
		die_perror("Can't set GID to %u", gid);

	if (setuid(uid))
		die_perror("Can't set UID to %u", uid);
}

/**
 * isolate_prefork() - No-op isolation hook
 * @c:	Execution context
 *
 * Return: always zero
 */
int isolate_prefork(const struct ctx *c)
{
	(void)c;

	return 0;
}

/**
 * isolate_postfork() - No-op isolation hook
 * @c:	Execution context
 */
void isolate_postfork(const struct ctx *c)
{
	(void)c;
}
